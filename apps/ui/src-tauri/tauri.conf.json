{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nemo",
  "version": "0.1.0",
  "identifier": "com.jiayu.nemo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Nemo", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 620 }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/nemo-server"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
